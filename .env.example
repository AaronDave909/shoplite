# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
# docker-compose.yml reads this file; scripts/stack.sh also sources it.

# --- Unified service tagging (DD_SERVICE is set per container in docker-compose.yml) ---
# DD_ENV is fixed to `staging` in docker-compose.yml.
DD_VERSION=2.0.0

# --- Source Code Integration (Datadog + Bits AI jump from a stack trace to the exact line in GitHub) ---
# scripts/stack.sh fills DD_GIT_COMMIT_SHA automatically from `git rev-parse HEAD`.
DD_GIT_REPOSITORY_URL=https://github.com/YOUR_GITHUB_USER/shoplite

# --- Datadog Agent container ---
# In Codespaces, set these as Codespaces secrets instead and leave them commented out here.
# DD_API_KEY=
# DD_SITE=datadoghq.com

# --- Databases (sandbox-only passwords; the databases are not exposed outside Docker) ---
POSTGRES_PASSWORD=shoplite
# Password for the `datadog` Postgres user that Database Monitoring logs in as.
DD_POSTGRES_PASSWORD=datadog

# --- Chaos & Crash Testing Panel (set to false to remove the chaos endpoints) ---
CHAOS_ENABLED=true

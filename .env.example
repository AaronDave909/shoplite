# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# --- Unified service tagging (used by APM, logs, Error Tracking, Bits AI) ---
DD_SERVICE=shoplite
DD_ENV=sandbox
DD_VERSION=1.0.0

# --- Tracer -> local Datadog Agent ---
DD_AGENT_HOST=localhost
DD_TRACE_AGENT_PORT=8126
DD_LOGS_INJECTION=true
DD_RUNTIME_METRICS_ENABLED=true
DD_PROFILING_ENABLED=false

# --- Source Code Integration (lets Datadog + Bits AI jump from a stack trace to the exact line in GitHub) ---
# scripts/start.sh fills DD_GIT_COMMIT_SHA automatically from `git rev-parse HEAD`.
DD_GIT_REPOSITORY_URL=https://github.com/YOUR_GITHUB_USER/shoplite

# --- Only used by docker-compose (the Agent container). The native macOS Agent reads its own datadog.yaml. ---
DD_API_KEY=
DD_SITE=datadoghq.com

PORT=3000

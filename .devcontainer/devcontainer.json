{
  "name": "ShopLite microservices + Datadog Agent",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "secrets": {
    "DD_API_KEY": {
      "description": "Datadog API key (Organization Settings → API Keys). Used only by the Datadog Agent container.",
      "documentationUrl": "https://docs.datadoghq.com/account_management/api-app-keys/"
    },
    "DD_SITE": {
      "description": "Your Datadog site, e.g. datadoghq.com (US1), us5.datadoghq.com, datadoghq.eu."
    }
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "ShopLite storefront",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/start-agent.sh",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  }
}

{
  "name": "shoplite",
  "version": "2.0.0",
  "description": "ShopLite microservices sandbox (storefront, checkout, promo, inventory) instrumented with Datadog APM, DBM, logs and Error Tracking, with intentional bugs and chaos buttons for Bits AI.",
  "private": true,
  "workspaces": [
    "services/storefront",
    "services/checkout",
    "services/promo",
    "services/inventory"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "test": "npm test --workspaces",
    "validate": "node scripts/validate.js",
    "traffic": "node scripts/traffic.js",
    "stack:up": "./scripts/stack.sh up",
    "stack:down": "./scripts/stack.sh down",
    "stack:logs": "./scripts/stack.sh logs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17"
  }
}
